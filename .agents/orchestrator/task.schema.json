{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manual agent handoff task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "to",
    "request"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "to": {
      "enum": [
        "codex",
        "gemini"
      ]
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
