#!/bin/bash --login
#SBATCH -o o.%j
#SBATCH -e e.%j
#SBATCH -J orca
#SBATCH --ntasks=192
#SBATCH --ntasks-per-node=192
#SBATCH -p dev
#SBATCH --time=01:00:00
#SBATCH --account=FALCON_SLURM_ACCOUNT

# Default queue profile: dev / 1 hour
# For production profile use:
# sbatch -p standard --time=24:00:00 sub_orca_python_falcon

# Falcon AMD Genoa 9654 Processor - 96 core 2.40 GHz
set -eu

module purge
module load Python/3.11.5-GCCcore-13.2.0
module load ORCA

###################################
#     SPECIFIC ENV VARIABLES      #
###################################
export OMP_NUM_THREADS=1
#########################################

ulimit -s unlimited
ulimit -c 0

# Set python environment
. /scratch/PROJECT/shared/venv/mace_venv/bin/activate
export PYTHONPATH=/scratch/PROJECT/shared/software/github/cplas/:$PYTHONPATH
export PYTHONPATH=/scratch/PROJECT/shared/software/github/carmm:$PYTHONPATH
export PYTHONPATH=/scratch/PROJECT/shared/software/github/CatLearn/:$PYTHONPATH

# Set scratch + run directories
export SCRATCH=/scratch/PROJECT/$USER
export TEMP_DIRECTORY=$SCRATCH/$SLURM_JOB_ID
export HOME_DIRECTORY=$PWD

mkdir -p "$TEMP_DIRECTORY"
cp -r * "$TEMP_DIRECTORY"
cd "$TEMP_DIRECTORY"

# Run the application
time python input.py > "log.$SLURM_JOB_ID"

# Return calculation files
mv "$TEMP_DIRECTORY" "$HOME_DIRECTORY"
