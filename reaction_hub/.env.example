# Sanitized Reaction Hub environment template.
# Copy to reaction_hub/.env for local use and replace placeholder values.
# Do not commit real usernames, passwords, private key paths, account codes, or
# institution/project-specific filesystem paths.

# Django
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-local-dev-secret
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
DEFAULT_FROM_EMAIL=noreply@reaction-hub.local

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db
REACTION_HUB_SYNC_HPC_JOBS_INTERVAL_SECONDS=600
REACTION_HUB_INGEST_INTERVAL_SECONDS=600

# Ingestion and local cache paths
REACTION_HUB_INGEST_ROOT=../utilities/similarity
REACTION_HUB_REMOTE_CACHE_ROOT=.remote_cache
REACTION_HUB_INGEST_REMOTE_ORCA_READ=False
REACTION_HUB_SYNC_STRICT_COMPLETED_REQUIRES_PROPERTIES=False

# SSH behaviour for scheduler polling/submission.
# Store real host/user/key values in the database/admin, not in this example.
REACTION_HUB_SYNC_PREFLIGHT_REACHABILITY=True
REACTION_HUB_SYNC_PREFLIGHT_TIMEOUT_SECONDS=1.5
REACTION_HUB_SSH_FORCE_TTY=False
REACTION_HUB_SSH_BATCH_MODE=True
REACTION_HUB_SSH_CLEAN_BASH=True
REACTION_HUB_SSH_TIMEOUT_SECONDS=60
REACTION_HUB_SSH_BASH_PATH=bash

# Generic Slurm submit defaults
REACTION_HUB_SUBMIT_REMOTE_RUNS_ROOT=/work/PROJECT/GROUP/{username}/reaction_hub_runs
REACTION_HUB_SUBMIT_SCRATCH_BASE=/scratch/PROJECT/{username}
REACTION_HUB_SUBMIT_DEFAULT_MODULES=epcc-setup-env,cray-python,orca/6.0.0
REACTION_HUB_SUBMIT_DEFAULT_VENV_ACTIVATE_PATH=/path/to/venv/bin/activate
REACTION_HUB_SUBMIT_DEFAULT_PYTHONPATH=/path/to/repo,/path/to/dependency
REACTION_HUB_SUBMIT_DEFAULT_ACCOUNT=SLURM_ACCOUNT
REACTION_HUB_SUBMIT_DEFAULT_PARTITION=standard
REACTION_HUB_SUBMIT_DEFAULT_QOS=
REACTION_HUB_SUBMIT_DEFAULT_WALLTIME=24:00:00
REACTION_HUB_SUBMIT_SLURM_PRESETS_JSON=
REACTION_HUB_SUBMIT_TDDFT_DEFAULT_QOS=long
REACTION_HUB_SUBMIT_TDDFT_DEFAULT_WALLTIME=96:00:00
REACTION_HUB_SUBMIT_AL_STEPS_PER_ITER=100
REACTION_HUB_SUBMIT_MAX_AL_STEPS_PER_ITER=200
REACTION_HUB_CT_SERIAL_WALLTIME=24:00:00
REACTION_HUB_SERIAL_QUEUE_MAX_JOBS=8
REACTION_HUB_GPU_QUEUE_MAX_JOBS=2
REACTION_HUB_TASKFARM_QUEUE_MAX_JOBS=128

# Local visualization/rendering helpers
REACTION_HUB_ASE_GUI_COMMAND=python -m ase gui
# Leave empty to auto-detect the safest xyzrender command for the active interpreter.
REACTION_HUB_XYZRENDER_COMMAND=
REACTION_HUB_XYZRENDER_GIF_ROT=xy
REACTION_HUB_XYZRENDER_ROT_FRAMES=200
REACTION_HUB_XYZRENDER_GIF_SIZE=900x900
REACTION_HUB_XYZRENDER_GIF_WIDTH=0
REACTION_HUB_XYZRENDER_GIF_HEIGHT=0
REACTION_HUB_XYZRENDER_FIXED_SCALE_ANCHOR_SYMBOL=H


# Optional TRH408-style UI prefill.
REACTION_HUB_SUBMIT_TRH408_HOST=trh408.example.invalid
REACTION_HUB_SUBMIT_TRH408_PORT=22
REACTION_HUB_SUBMIT_TRH408_USERNAME=hpc_username
REACTION_HUB_SUBMIT_TRH408_VENV_ACTIVATE_PATH=/srv/research/PROJECT/venv/bin/activate
REACTION_HUB_SUBMIT_TRH408_PYTHONPATH=/srv/research/PROJECT/repo
REACTION_HUB_SUBMIT_TRH408_MODULES=
REACTION_HUB_SUBMIT_TRH408_REMOTE_RUNS_ROOT=/home/{username}/reaction_hub_runs
REACTION_HUB_SUBMIT_TRH408_SCRATCH_BASE=

# Optional FALCON-style UI prefill.
REACTION_HUB_SUBMIT_FALCON_HOST=hpc-login.example.invalid
REACTION_HUB_SUBMIT_FALCON_PORT=22
REACTION_HUB_SUBMIT_FALCON_USERNAME=hpc_username
REACTION_HUB_SUBMIT_FALCON_VENV_ACTIVATE_PATH=/scratch/PROJECT/shared/venv/bin/activate
REACTION_HUB_SUBMIT_FALCON_PYTHONPATH=/scratch/PROJECT/shared/software/repo,/scratch/PROJECT/shared/software/dependency
REACTION_HUB_SUBMIT_FALCON_MODULES=Python,ORCA
REACTION_HUB_SUBMIT_FALCON_REMOTE_RUNS_ROOT=/shared/home1/{username}/reaction_hub_runs
REACTION_HUB_SUBMIT_FALCON_SCRATCH_BASE=/scratch/PROJECT/{username}
REACTION_HUB_SUBMIT_FALCON_DEFAULT_ACCOUNT=SLURM_ACCOUNT

# Optional co-adsorbate model defaults. Keep paths generic in committed files.
REACTION_HUB_COADSORBATE_MACE_MODEL_PATH=/path/to/mace-model.model
REACTION_HUB_COADSORBATE_MACE_MODEL_PATH_BY_HPC_JSON={"example_hpc":"/path/to/mace-model.model"}
